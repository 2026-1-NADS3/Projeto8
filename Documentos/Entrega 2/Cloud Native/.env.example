# =============================================================================
# .env.example — Template de variáveis de ambiente
# =============================================================================
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores marcados com <PREENCHER>
#   3. NUNCA commite o .env com valores reais (já está no .gitignore)
#   4. Em produção, use um gerenciador de segredos (Vault, AWS Secrets Manager)
#
# Variáveis marcadas com :? causam erro imediato se não definidas no .env
# Variáveis marcadas com :- usam o valor padrão se não definidas
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
# APLICAÇÃO
# ─────────────────────────────────────────────────────────────────────────────
# Nome da aplicação (aparece nos logs e no actuator/info)
APP_NAME=backend-api

# Versão semântica — incrementar a cada release
APP_VERSION=1.0.0

# Data do build (preenchida automaticamente no CI/CD)
# BUILD_DATE=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
BUILD_DATE=

# Hash do commit Git (para rastreabilidade da imagem)
# GIT_COMMIT=$(git rev-parse --short HEAD)
GIT_COMMIT=

# Fuso horário dos containers
TZ=America/Sao_Paulo


# ─────────────────────────────────────────────────────────────────────────────
# SPRING BOOT
# ─────────────────────────────────────────────────────────────────────────────
# Profile ativo: development | staging | production
SPRING_PROFILE=development

# Comportamento do Hibernate com o schema:
#   none     → não faz nada (use em produção com migrations Flyway/Liquibase)
#   validate → valida o schema contra as entidades (recomendado)
#   update   → atualiza o schema automaticamente (apenas desenvolvimento)
#   create   → recria do zero (CUIDADO: apaga todos os dados)
DDL_AUTO=update

# Exibir SQL gerado pelo Hibernate nos logs (true apenas em desenvolvimento)
SHOW_SQL=false


# ─────────────────────────────────────────────────────────────────────────────
# BANCO DE DADOS — PostgreSQL
# ─────────────────────────────────────────────────────────────────────────────
# Nome do banco de dados
DB_NAME=appdb

# Usuário da aplicação (NÃO use o superusuário "postgres")
DB_USER=appuser

# Senha do banco — USE UMA SENHA FORTE EM PRODUÇÃO
# Gere uma senha segura: openssl rand -base64 32
DB_PASS=<PREENCHER_COM_SENHA_SEGURA>

# Pool de conexões HikariCP
DB_POOL_SIZE=10

# Porta do PostgreSQL exposta ao HOST (apenas desenvolvimento)
# Em produção, remova ou não mapeie esta porta
POSTGRES_HOST_PORT=5432

# Inserir dados de seed no primeiro init do banco?
# true: insere usuários e produtos de exemplo (desenvolvimento)
# false: banco começa vazio (produção)
POSTGRES_SEED_DATA=true


# ─────────────────────────────────────────────────────────────────────────────
# API — Portas e Rede
# ─────────────────────────────────────────────────────────────────────────────
# Porta da API exposta ao HOST
# Em produção (com Nginx), não exponha esta porta
API_PORT=8080

# Porta HTTP do Nginx (reverse proxy)
HTTP_PORT=80

# Porta HTTPS do Nginx
HTTPS_PORT=443

# Porta do Adminer (gerenciador visual do banco) — apenas desenvolvimento
ADMINER_PORT=8888


# ─────────────────────────────────────────────────────────────────────────────
# JVM — Configurações Java
# ─────────────────────────────────────────────────────────────────────────────
# Ajuste de memória conforme o ambiente:
#   Desenvolvimento: -Xms256m -Xmx512m
#   Produção:        -Xms512m -Xmx1g
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs/heapdump.hprof


# ─────────────────────────────────────────────────────────────────────────────
# RECURSOS DOS CONTAINERS
# ─────────────────────────────────────────────────────────────────────────────
API_MEMORY_LIMIT=1g
API_CPU_LIMIT=1.0
POSTGRES_MEMORY_LIMIT=512m


# ─────────────────────────────────────────────────────────────────────────────
# REGISTRY DE IMAGENS (CI/CD)
# ─────────────────────────────────────────────────────────────────────────────
# Prefixo do registry Docker (vazio para usar localmente)
# Exemplos:
#   Docker Hub:  usuario/
#   AWS ECR:     123456789.dkr.ecr.us-east-1.amazonaws.com/
#   GCP GCR:     gcr.io/meu-projeto/
REGISTRY=
